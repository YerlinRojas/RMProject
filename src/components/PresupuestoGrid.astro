---
interface Props {
  slides: {
    title: string;
    img: string;
    link: string;
  }[];
}

const { slides } = Astro.props;
---

<section class="grid md:grid-cols-3 gap-6">

  {
    slides.map(({ img, title, link }) => (

      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative h-[520px] rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2"
      >

        <img
          src={img}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110"
        />

       <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent group-hover:from-[#B71C1C]/90 transition duration-500"></div>
        <div class="absolute inset-0 flex flex-col justify-end p-8">

            <h2 class="text-4xl font-bold text-white mb-3">
                {title}
            </h2>

            <p class="text-white/90 leading-relaxed mb-6">
                Solicitar presupuesto para {title.toLowerCase()}.
            </p>

            <span class="w-fit rounded-full bg-[#EB5D5D] px-6 py-3 text-white font-semibold transition group-hover:bg-white group-hover:text-[#EB5D5D]">
                Comenzar →
            </span>

        </div>

      </a>

    ))
  }

</section>
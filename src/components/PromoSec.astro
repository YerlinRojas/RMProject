---
interface Props {
  slides: {
    title: string;
    img: string;
    link: string;
  }[];
}

const { slides } = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-4 py-8">
  {slides.map(({ img, link, title }) => (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="relative block h-[85vh] min-h-[600px] overflow-hidden rounded-3xl group shadow-2xl"
    >
      <!-- Imagen -->
      <img
        src={img}
        alt={title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />

      <!-- Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

      <!-- Contenido -->
      <div class="absolute bottom-0 left-0 z-10 w-full p-8 md:p-16">

        <span class="uppercase tracking-[0.4em] text-white/70 text-xs md:text-sm">
          Rústicos Mendoza
        </span>

        <h1 class="mt-3 text-white text-5xl md:text-7xl font-bold tracking-tight">
          {title}
        </h1>

        <p class="mt-4 max-w-xl text-white/80 text-lg leading-relaxed">
          Descubrí nuestra línea completa de pisos, revestimientos,
          mesadas y terminaciones para cada proyecto.
        </p>

        <div class="mt-10 flex gap-4">

          <span
            class="px-8 py-3 rounded-full bg-white text-black font-semibold transition hover:bg-neutral-200"
          >
            Ver catálogo
          </span>       
        </div>

      </div>
    </a>
  ))}
</section>
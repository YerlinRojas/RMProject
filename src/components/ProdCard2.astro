---
interface Props {
  title: string;
  desc: string;
  desc2: string;
  img: string;
  img1?: string;
  img2?: string;
  punteo1?: string;
  punteo2?: string;
  punteo3?: string;
  punteo4?: string;
  punteo5?: string;
  punteo6?: string;
}

const {
  title,
  desc,
  desc2,
  img,
  img1,
  img2,
  punteo1,
  punteo2,
  punteo3,
  punteo4,
  punteo5,
  punteo6,
} = Astro.props;

// Filtra imágenes vacías, undefined o null
const images = [img, img1, img2].filter(
  (image) => image && image.trim() !== "",
);

// IDs únicos
const modalId = `modal-${title.replace(/\s+/g, "-").toLowerCase()}`;
const carouselId = `carousel-${title.replace(/\s+/g, "-").toLowerCase()}`;

const caracteristicas = [
  punteo1,
  punteo2,
  punteo3,
  punteo4,
  punteo5,
  punteo6,
].filter((item) => item && item.trim() !== "");
---

<div
  class="w-full max-w-[190px] bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  <a
    data-modal-target={`${title}`}
    data-modal-toggle={`${title}`}
    class="block overflow-hidden bg-gray-100"
  >
    <img
      src={`${images[0]}`}
      alt={`${title}`}
      class="w-full h-40 object-cover transition-transform duration-500 hover:scale-110"
    />
  </a>

  <div class="p-4">
    <h5 class="text-sm font-semibold text-center text-gray-800 min-h-[42px]">
      {title}
    </h5>

    <button
      data-modal-target={`${modalId}`}
      data-modal-toggle={`${modalId}`}
      class="mt-4 w-full rounded-full bg-[#EB5D5D] py-2 text-xs font-medium text-white transition hover:bg-red-600"
    >
      Ver más
    </button>
  </div>
</div>

<div
  id=`${modalId}`
  tabindex="-1"
  aria-hidden="true"
  class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 flex justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full"
>
  <div class="relative p-4 w-full max-w-6xl max-h-full">
    <div
      class="bg-white dark:bg-gray-800 rounded-lg shadow-lg flex flex-col md:flex-row overflow-hidden"
    >
      <!-- Carrusel grande al lado izquierdo -->
      <div class="md:w-3/5 w-full">
        <div
          id="controls-carousel"
          class="relative w-full h-full"
          data-carousel="static"
        >
          <div class="relative h-72 md:h-[500px] overflow-hidden">
            {
              images.map((image, index) => (
                <div
                  class={
                    index === 0
                      ? "duration-700 ease-in-out"
                      : "hidden duration-700 ease-in-out"
                  }
                  data-carousel-item={index === 0 ? "active" : ""}
                >
                  <img
                    src={image}
                    alt={title}
                    class="absolute block w-full h-full object-cover top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
                  />
                </div>
              ))
            }
          </div>

          <!-- Controles -->
          {
            images.length > 1 && (
              <>
                <button
                  type="button"
                  class="absolute top-0 start-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
                  data-carousel-prev
                >
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 dark:bg-gray-800/30 group-hover:bg-white/50 dark:group-hover:bg-gray-800/60">
                    <svg
                      class="w-4 h-4 text-white dark:text-gray-800"
                      fill="none"
                      viewBox="0 0 6 10"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 1 1 5l4 4"
                      />
                    </svg>
                  </span>
                </button>

                <button
                  type="button"
                  class="absolute top-0 end-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
                  data-carousel-next
                >
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 dark:bg-gray-800/30 group-hover:bg-white/50 dark:group-hover:bg-gray-800/60">
                    <svg
                      class="w-4 h-4 text-white dark:text-gray-800"
                      fill="none"
                      viewBox="0 0 6 10"
                    >
                      <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="m1 9 4-4-4-4"
                      />
                    </svg>
                  </span>
                </button>
              </>
            )
          }
        </div>
      </div>

      <!-- Lado derecho con muestra + texto + botón -->
      <div
        class="md:w-2/5 w-full p-6 flex flex-col justify-start items-center gap-6"
      >
        <!-- Imagen muestra -->
        <img
          src={`${images[0]}`}
          alt=`${title}`
          class="w-40 h-40 object-cover border border-gray-300 rounded shadow"
        />

        <!-- Texto -->
        <div class="flex flex-col gap-5 w-full">
          <!-- Título -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">
              {title}
            </h2>

            {
              desc2 && (
                <p class="text-gray-600 leading-relaxed text-sm">{desc2}</p>
              )
            }
          </div>

          <!-- Características -->
          {
            caracteristicas.length > 0 && (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-800 mb-3">
                  Características
                </h3>

                <ul class="space-y-2">
                  {caracteristicas.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-gray-700">
                      <svg
                        class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>

                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <!-- Botón -->
        <a
          href=`https://api.whatsapp.com/send?phone=5492613622105&text=Hola%20Rústicos%20Mendoza,%20quiero%20consultar%20por%20${title}.`
          target="_blank"
          class="mt-4 flex justify-center items-center gap-2 px-6 py-2 text-sm font-medium text-white bg-green-600 rounded-3xl hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-blue-300"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="white"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M2.08359 12.2811C2.08305 14.0277 2.54141 15.7328 3.41281 17.2357L2 22.3711L7.27898 20.9931C8.73352 21.7826 10.3712 22.1989 12.0376 22.1995H12.0419C17.53 22.1995 21.9977 17.7532 22 12.289C22.0009 9.64087 20.9659 7.15069 19.0859 5.27745C17.2057 3.40443 14.7057 2.37218 12.0419 2.37109C6.55281 2.37109 2.08578 6.8168 2.08359 12.2811Z"
            ></path>
            <path
              d="M9.06187 6.89771C8.83819 6.4044 8.60278 6.39445 8.39006 6.3858..."
            ></path>
          </svg>
          CONSULTAR
        </a>
      </div>
    </div>
  </div>
</div>

